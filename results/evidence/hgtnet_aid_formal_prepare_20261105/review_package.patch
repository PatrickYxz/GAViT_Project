+
+
+def api():
+    try:
+        return importlib.import_module('external_baselines.hgtnet.aid_formal_protocol')
+    except ModuleNotFoundError as exc:
+        raise AssertionError('AID formal protocol interface must be implemented') from exc
+
+
+def binding():
+    p = api()
